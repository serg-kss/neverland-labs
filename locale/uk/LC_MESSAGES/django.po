msgstr "UX/UI-дизайн та прототипи у Figma"

#: pages/templates/pages/ux.html:200
msgid "Design support &amp; iteration"
msgstr "Дизайн-супровід та ітерації"

#: pages/templates/pages/ux.html:208
msgid ""
